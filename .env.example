# OpenRouter: get a key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
# The OpenRouter free-model router automatically selects an available free model.
OPENROUTER_MODEL=openrouter/free
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=Nexus Agent Studio

# Supabase is optional for local UI development. If configured, both values are required.
# Apply backend/migrations/001_init.sql in the target project's SQL editor first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional tuning
# SQLITE_PATH=backend/data/nexus.sqlite3
# MAX_TOOL_ROUNDS=3
# MAX_CONTEXT_MESSAGES=30
# CORS_ORIGINS=http://localhost:5173
